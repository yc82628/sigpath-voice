# Copy this file to .env and fill it in. Never commit .env.

# Retell dashboard > API Keys. Secret: it stays on the server and signs
# every webhook and tool request Retell sends you.
RETELL_API_KEY=

# Retell dashboard > public key for web calls. Add localhost (and your tunnel
# domain, if you open the page through it) to its allowed domains.
# This one is safe in the browser.
RETELL_PUBLIC_KEY=

# The public https URL Retell uses to reach this server, for example
# https://something.trycloudflare.com from `cloudflared tunnel --url http://localhost:3000`.
PUBLIC_BASE_URL=

# Printed by `npm run setup-agent` on the first run. With these set, the
# script updates the existing LLM and agent instead of making new ones.
RETELL_LLM_ID=
RETELL_AGENT_ID=

# Optional. Defaults to retell-Cimo. The setup script lists other voices if
# this one isn't on your account.
RETELL_VOICE_ID=

# Optional. E.164 number for transfer_to_human, like +4930123456. Leave it
# empty and the agent has no transfer tool. Transfers need phone calls, so
# test this one after buying a number.
TRANSFER_NUMBER=

# Optional. Adds a delay to every tool response, to reproduce a slow-API
# incident on purpose. Try 6000 with the 8000 ms tool timeout.
TOOL_DELAY_MS=

PORT=3000
