{
  "name": "sigpath-voice",
  "version": "1.0.0",
  "description": "Phone support agent for SigPath orders, built on Retell AI",
  "scripts": {
    "dev": "npm run build:web && tsx watch src/server.ts",
    "start": "npm run build:web && tsx src/server.ts",
    "build:web": "esbuild src/web/call.ts --bundle --format=esm --target=es2020 --minify --outfile=public/build/call.js",
    "setup-agent": "tsx scripts/setup-agent.ts",
    "simulate": "tsx scripts/simulate.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "retell-client-js-sdk": "3.0.3",
    "retell-sdk": "^6.2.21"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "esbuild": "0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "private": true
}
